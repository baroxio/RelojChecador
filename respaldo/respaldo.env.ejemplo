# Copia este archivo como respaldo.env (junto a respaldar.sh) y llena los valores.
# Formato: CLAVE=valor, una por línea, SIN comillas (se lee como texto; los símbolos como & $ # ? ! valen tal cual).
# Tiene contraseñas: chmod 600 respaldo.env. NUNCA lo subas a GitHub (el repositorio es público).

# Ruta del comando docker en DSM. Si por SSH "which docker" muestra otra, pon esa.
DOCKER=/usr/local/bin/docker

# Carpeta del NAS donde se guardan los respaldos (una carpeta compartida con espacio de sobra).
DESTINO=/volume1/respaldos/relojchecador

# Conexión a Postgres. Usa la del "Session pooler" (funciona por IPv4):
#   Supabase > botón Connect > Session pooler > URI. El usuario tiene la forma  respaldo.bclmvyifdxalnfxzjmyj
#   Consejo: usa una contraseña de solo letras y números (larga). Si lleva @ / # ? : debe ir codificada en la URL
#   (@ = %40, / = %2F, # = %23, ? = %3F, : = %3A).
SUPABASE_DB_URL=postgresql://respaldo.bclmvyifdxalnfxzjmyj:LA_CONTRASEÑA@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Selfies: llaves S3 de Supabase (Project Settings > Storage > S3 Connection > New access key).
# Cópialo tal cual lo muestra Supabase en Project Settings > Storage > S3 Connection.
S3_ENDPOINT=https://bclmvyifdxalnfxzjmyj.supabase.co/storage/v1/s3
S3_REGION=us-west-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BUCKET=selfies
# SALTAR_SELFIES=1     # solo si decides NO respaldar las selfies (no se recomienda)

# Cuánto se conserva (valores por defecto).
# DIAS_DIARIOS=30      # todos los respaldos de los últimos 30 días
# MESES=12             # y el del día 1 de cada mes durante 12 meses
# MIN_LIBRE_MB=1024    # no empieza si el NAS tiene menos espacio libre
