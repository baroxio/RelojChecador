{
  "name": "RelojChecador",
  "short_name": "RelojChecador",
  "description": "Control de asistencia por WhatsApp: quién llegó, quién falta y las correcciones.",
  "lang": "es-MX",
  "dir": "ltr",
  "start_url": "./?origen=app",
  "scope": "./",
  "id": "/RelojChecador/panel/",
  "display": "standalone",
